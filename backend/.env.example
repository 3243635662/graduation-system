# ========================================
# NestJS 服务配置
# ========================================

PORT=3000
CORS_ORIGIN=http://localhost:5173


# ========================================
# MySQL 8.4
# ========================================

MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation_app
MYSQL_PASSWORD=your_mysql_user_password
MYSQL_PORT=3306

# Prisma 7
# 开发数据库连接串
DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system"
# 影子数据库连接串（Prisma Migrate 需要）
SHADOW_DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system_shadow"


# ========================================
# Seed 相关（初始超管账号）
# ========================================

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password
SUPER_ADMIN_DISPLAY_NAME=Super-Admin


# ========================================
# Redis 7.4
# ========================================

REDIS_PASSWORD=your_redis_password
REDIS_PORT=6380
REDIS_URL="redis://:your_redis_password@127.0.0.1:6380"


# ========================================
# ChromaDB 1.5.9 (AI 向量数据库)
# ========================================

CHROMA_PORT=8001
CHROMA_URL=http://127.0.0.1:8001
