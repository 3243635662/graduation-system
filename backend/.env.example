# ========================================
# NestJS 服务配置
# ========================================

PORT=3000
CORS_ORIGIN=http://localhost:5173


# ========================================
# MySQL 8.4
# ========================================

MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation_app
MYSQL_PASSWORD=your_mysql_user_password
MYSQL_PORT=3306

# Prisma 7
# 开发数据库连接串
DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system"
# 影子数据库连接串（Prisma Migrate 需要）
SHADOW_DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system_shadow"


# ========================================
# Seed 相关（初始超管账号）
# ========================================

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password
SUPER_ADMIN_DISPLAY_NAME=Super-Admin


# ========================================
# Auth 身份认证
# ========================================

# Access Token 签名密钥（必须修改为强随机值，不能硬编码到代码里）
JWT_ACCESS_SECRET=please_change_me_to_a_long_random_secret
# Access Token 有效期（秒），默认 900 = 15 分钟
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh Token 有效期（天），默认 7 天
REFRESH_TOKEN_TTL_DAYS=7
# Refresh Token 轮换宽限期（毫秒），默认 30000
# 用于消除多标签页并发刷新的误判；仅单体部署生效，多实例需改用共享存储
REFRESH_ROTATION_GRACE_MS=30000

# Refresh Token Cookie
# 生产环境（HTTPS）必须设置为 true
COOKIE_SECURE=false
# lax（同站/反向代理部署推荐）| strict | none（跨站部署需额外 CSRF 防护）
COOKIE_SAME_SITE=lax
# 跨子域共享 Cookie 时才需要设置，例如 .example.com
COOKIE_DOMAIN=


# ========================================
# Redis 7.4
# ========================================

REDIS_PASSWORD=your_redis_password
# 本机开发：宿主机端口 6380（容器内是 6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_DB=0
# 可选：需要 URL 形式的客户端用它，端口同样是 6380
REDIS_URL="redis://:your_redis_password@127.0.0.1:6380/0"


# ========================================
# SMTP - yeah.net（注册邮箱验证码）
# ========================================

SMTP_HOST=smtp.yeah.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@yeah.net
# 邮箱客户端授权码，不是邮箱登录密码
SMTP_PASS=your-mail-client-authorization-code
SMTP_FROM=your-account@yeah.net
SMTP_FROM_NAME=Graduation Management System


# ========================================
# Email verification（注册验证码）
# ========================================

# 独立随机强密钥（>=16 字符），禁止复用 JWT/Redis/SMTP 密码
OTP_PEPPER=
EMAIL_CODE_TTL_SECONDS=120
EMAIL_CODE_RESEND_INTERVAL_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_SENDS_PER_HOUR=5
EMAIL_CODE_MAX_SENDS_PER_IP_HOUR=20
# 可选：Redis Key 用途前缀，测试可用独立前缀隔离数据
# EMAIL_CODE_KEY_PREFIX=auth:email-code:register


# ========================================
# ChromaDB 1.5.9 (AI 向量数据库)
# ========================================

CHROMA_PORT=8001
CHROMA_URL=http://127.0.0.1:8001
