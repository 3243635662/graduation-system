# ========================================
# NestJS 服务配置
# ========================================

PORT=3000
CORS_ORIGIN=http://localhost:5173


# ========================================
# MySQL 8.4
# ========================================

MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation_app
MYSQL_PASSWORD=your_mysql_user_password
MYSQL_PORT=3306

# Prisma 7
# 开发数据库连接串
DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system"
# 影子数据库连接串（Prisma Migrate 需要）
SHADOW_DATABASE_URL="mysql://graduation_app:your_mysql_user_password@127.0.0.1:3306/graduation_system_shadow"


# ========================================
# Seed 相关（初始超管账号）
# ========================================

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password
SUPER_ADMIN_DISPLAY_NAME=Super-Admin


# ========================================
# Auth 身份认证
# ========================================

# Access Token 签名密钥（必须修改为强随机值，不能硬编码到代码里）
JWT_ACCESS_SECRET=please_change_me_to_a_long_random_secret
# Access Token 有效期（秒），默认 900 = 15 分钟
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh Token 有效期（天），默认 7 天
REFRESH_TOKEN_TTL_DAYS=7
# Refresh Token 轮换宽限期（毫秒），默认 30000
# 用于消除多标签页并发刷新的误判；仅单体部署生效，多实例需改用共享存储
REFRESH_ROTATION_GRACE_MS=30000

# Refresh Token Cookie
# 生产环境（HTTPS）必须设置为 true
COOKIE_SECURE=false
# lax（同站/反向代理部署推荐）| strict | none（跨站部署需额外 CSRF 防护）
COOKIE_SAME_SITE=lax
# 跨子域共享 Cookie 时才需要设置，例如 .example.com
COOKIE_DOMAIN=


# ========================================
# Redis 7.4
# ========================================

REDIS_PASSWORD=your_redis_password
REDIS_PORT=6380
REDIS_URL="redis://:your_redis_password@127.0.0.1:6380"


# ========================================
# ChromaDB 1.5.9 (AI 向量数据库)
# ========================================

CHROMA_PORT=8001
CHROMA_URL=http://127.0.0.1:8001
