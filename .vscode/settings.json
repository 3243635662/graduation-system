{
  // OXC 默认格式化工具
  "editor.defaultFormatter": "oxc.oxc-vscode",

  // 保存时自动格式化
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  // 保存时自动修复 Oxlint 能修复的问题
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },

  "i18n-ally.localesPaths": ["frontend/src/plugins/i18n"],
  "i18n-ally.keystyle": "flat",

  // Tailwind CSS 4 的 @theme / @utility / @custom-variant 等是它自己的 at-rule，
  // 编辑器内置 CSS 校验只认标准 CSS，会误报 unknownAtRule；构建链本身能正常处理。
  "css.lint.unknownAtRules": "ignore",

  "cSpell.words": [
    "appendfsync",
    "appendonly",
    "autoplay",
    "everysec",
    "formkit",
    "healthcheck",
    "iconify",
    "lucide",
    "mysqladmin",
    "ofetch",
    "persistedstate",
    "pinia",
    "REDISCLI",
    "reka",
    "requirepass",
    "sonner",
    "tanstack",
    "unovis",
    "unplugin",
    "uroot",
    "vaul",
    "vueuse",
    "Whbbit1999"
  ],
  "[vue]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  }
}
