{
  "name": "shadcn-vue-admin",
  "version": "2.1.2",
  "private": false,
  "description": "Admin Dashboard UI crafted with Shadcn-vue, Vue3 and Vite. Built with responsiveness and accessibility in mind.",
  "keywords": [
    "eslint",
    "pinia",
    "pnpm",
    "shadcn-vue",
    "tailwindcss",
    "tanstack/vue-form",
    "tanstack/vue-query",
    "tanstack/vue-table",
    "typescript",
    "vite",
    "vue",
    "vue-router",
    "zod"
  ],
  "homepage": "https://shadcn-vue-admin.netlify.app/",
  "license": "MIT",
  "author": "Whbbit1999",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whbbit1999/shadcn-vue-admin"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "vue-tsc -b",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.59.0",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-query": "^5.104.5",
    "@tanstack/vue-table": "^9.3.1",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "motion-v": "2.4.4",
    "nprogress": "^0.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "universal-cookie": "^8.1.2",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/vue": "^5.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "cd frontend && pnpm exec nano-staged",
    "pre-push": "cd frontend && pnpm build"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,scss,less,html,md,mdx,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.28.6"
}
