{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["vue"],
  "env": {
    "builtin": true,
    "browser": true
  },
  "globals": {
    "definePage": "readonly"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "**/components/ui/**",
    "**/src/types/auto-import.d.ts",
    "**/src/types/route-map.d.ts"
  ]
}
