# ========================================
# Docker Compose 变量（仅 docker compose 读取）
# 复制为 .env 后填入真实值，.env 已被 Git 忽略
# ========================================

# MySQL 8.4
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation_app
MYSQL_PASSWORD=your_mysql_user_password
MYSQL_PORT=3306

# Redis 7.4
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6380
REDIS_MAXMEMORY=128mb

# ChromaDB 1.5.9
CHROMA_PORT=8001
