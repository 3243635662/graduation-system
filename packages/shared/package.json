{
  "name": "@graduation/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants and enums for the graduation system",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
